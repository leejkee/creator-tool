{
  "name": "creator-tool-desktop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "lint": "eslint src vite.config.ts --max-warnings 0",
    "lint:fix": "eslint src vite.config.ts --fix --max-warnings 0",
    "format": "prettier --write src vite.config.ts eslint.config.mjs .prettierrc.json",
    "format:check": "prettier --check src vite.config.ts eslint.config.mjs .prettierrc.json",
    "fix": "npm run lint:fix && npm run format",
    "check": "npm run lint && npm run format:check && npm run build",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@typescript-eslint/parser": "^8.72.1",
    "@vitejs/plugin-vue": "^6.0.7",
    "eslint": "^10.13.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "vite": "^8.0.16",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.5"
  }
}
